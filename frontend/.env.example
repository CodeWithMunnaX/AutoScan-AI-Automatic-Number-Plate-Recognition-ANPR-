# ==========================================
# AutoScan AI - Frontend Environment Variables
# ==========================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_random_secret_string_here

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth (Optional - for GitHub Login)
GITHUB_ID=your_github_client_id_here
GITHUB_SECRET=your_github_client_secret_here

# Neon Database & Cloudinary (Optional fallback credentials for frontend direct tools)
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/<database_name>?sslmode=require
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
GEMINI_API_KEY=your_gemini_api_key_here
