# ==========================================
# AutoScan AI - Backend Environment Variables
# ==========================================

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/<database_name>?sslmode=require

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Key (for license plate & vehicle analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
